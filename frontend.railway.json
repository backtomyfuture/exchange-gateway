{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "deploy/nginx/Dockerfile",
        "context": ".",
        "buildArgs": {
            "NGINX_ENV": "dev"
        }
    },
    "deploy": {
        "port": 8080,
        "numReplicas": 1,
        "sleep": false,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}