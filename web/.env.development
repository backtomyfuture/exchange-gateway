# =============================================================================
# 前端开发环境配置
# =============================================================================

# 开发服务器端口
VITE_PORT=3000

# 是否启用代理（开发时一般启用）
VITE_USE_PROXY=true

# API 基础路径
VITE_BASE_API=/api/v1

# 后端服务地址（修改为后端开发者的 IP 地址）
# 本地开发：http://127.0.0.1:8000
# 连接他人：http://192.168.x.x:8000
VITE_BACKEND_URL=http://127.0.0.1:8000
