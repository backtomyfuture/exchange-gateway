# =============================================================================
# Frontend Development Environment
# =============================================================================

# Application title (shown in browser tab and loading screen)
VITE_TITLE=Exchange Gateway

# Dev server port
VITE_PORT=3000

# Enable proxy (recommended during development)
VITE_USE_PROXY=true

# API base path
VITE_BASE_API=/api/v1

# Backend service URL (change to backend developer's IP as needed)
# Local: http://127.0.0.1:8000
# Remote: http://192.168.x.x:8000
VITE_BACKEND_URL=http://127.0.0.1:8000
