# ===========================================
# Exchange Gateway Configuration
# ===========================================
# This file contains NON-SECRET configuration only.
# Secrets (passwords, keys) are managed via ./secrets/ directory.
#
# Quick Start:
#   ./scripts/init-secrets.sh   # generate secrets (first time)
#   cp .env.example .env        # then edit below
#   docker compose --profile local-db --profile local-redis up -d

# ===========================================
# Database Connection (non-secret parts)
# ===========================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=exchange_gateway
DB_USER=root

# ===========================================
# Exchange Server (required for production)
# ===========================================
EXCHANGE_SERVER=your-exchange-server
EXCHANGE_DOMAIN=your-domain
EXCHANGE_EMAIL_SUFFIX=@your-domain.com

# ===========================================
# Optional
# ===========================================
# ENV=dev
# WORKERS=2
# BACKEND_PORT=8000
# NGINX_PORT=80
# REDIS_URL=redis://redis:6379/0
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# AUTO_MIGRATE=true
