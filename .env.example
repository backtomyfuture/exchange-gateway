# ===========================================
# Exchange Gateway — Environment Configuration
# ===========================================
# Secrets (passwords, keys) live in ./secrets/, NOT here.
# Run `./scripts/init-secrets.sh` to generate them.

# ── Database ──────────────────────────────────────────────────────────
# Default values work with the bundled MySQL container.
# To use an external database: comment out the mysql service in
# docker-compose.yml and update these values.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=exchange_gateway
DB_USER=root

# ── Redis ─────────────────────────────────────────────────────────────
# Default works with the bundled Redis container.
# To use an external Redis: comment out the redis service and set:
# REDIS_URL=redis://your-redis-host:6379/0

# ── Exchange Server (required for production) ─────────────────────────
EXCHANGE_SERVER=your-exchange-server
EXCHANGE_DOMAIN=your-domain
EXCHANGE_EMAIL_SUFFIX=@your-domain.com
EXCHANGE_TLS_INSECURE=false
# EXCHANGE_CA_FILE=/path/to/enterprise-ca.pem
# EXCHANGE_CA_DATA=

# ── Optional ──────────────────────────────────────────────────────────
# ENV=dev
# WORKERS=2
# BACKEND_PORT=8000
# NGINX_PORT=80
# API_PORT=18001
# MYSQL_PORT=13306
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Railway example: CORS_ORIGINS=https://esw.up.railway.app
# AUTO_MIGRATE=true
# EXCHANGE_EWS_REQUEST_TIMEOUT_SECONDS=20
# EXCHANGE_EWS_RETRY_MAX_WAIT_SECONDS=5
# EXCHANGE_EMAIL_LIST_TIMEOUT_SECONDS=45
# EXCHANGE_EMAIL_SYNC_TIMEOUT_SECONDS=45
# AUDIT_LOG_RETENTION_DAYS=14
# MAIL_LOG_BODY_RETENTION_DAYS=7
