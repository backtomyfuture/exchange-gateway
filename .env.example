# ===========================================
# Exchange Gateway - 配置文件
# ===========================================
# 复制此文件为 .env 并修改 Exchange 服务器配置即可启动
# cp .env.example .env

# ===========================================
# Exchange 邮件服务配置 (必填)
# ===========================================
EXCHANGE_SERVER=your-exchange-server
EXCHANGE_DOMAIN=your-domain
EXCHANGE_EMAIL_SUFFIX=@your-domain.com

# ===========================================
# 环境模式 (可选, 默认 dev)
# ===========================================
# dev: 开发模式 (自动生成密钥, HTTP, 宽松安全策略)
# prod: 生产模式 (需配置密钥, 建议 HTTPS, 严格安全策略)
# ENV=dev

# ===========================================
# 数据库配置 (Railway 提供 MYSQL_URL, VPS 部署请在 .env 设置)
# ===========================================
# DATABASE_URL: 统一连接格式 (必填)
# 格式: mysql://user:password@host:port/database
# 开发环境默认: mysql://root:root123@mysql:3306/exchange_gateway
# DATABASE_URL=mysql://root:password@localhost:3306/db_name

# ===========================================
# 安全配置 (生产环境必填, 开发模式自动生成)
# ===========================================
SECRET_KEY=                      # 生成方式: openssl rand -hex 32
EXCHANGE_ENCRYPTION_KEY=         # 生成方式: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"

# ===========================================
# 其他可选配置
# WORKERS=2                    # Gunicorn worker 数量
# BACKEND_PORT=8000            # 后端服务内部端口
# NGINX_PORT=80                # Nginx 访问端口
# REDIS_URL=redis://redis:6379/0
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================================
# Docker Compose 快速部署提示
# ===========================================
# 1. 如果是在已有 Nginx 的服务器上，建议修改 NGINX_PORT
# 2. 确保防火墙放行了对应端口
