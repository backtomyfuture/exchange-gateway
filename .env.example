# =============================================================================
# Exchange Gateway - Environment Configuration
# 
# Usage: cp .env.example .env
# Then edit .env with your values
# 
# ENV values: "dev" or "prod"
# - dev: DEBUG=true, HTTP only (for development)
# - prod: DEBUG=false, HTTPS enabled (for production)
# =============================================================================

# ===========================================
# Environment Mode
# ===========================================
ENV=dev

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=vue_fastapi_admin

# ===========================================
# Security Configuration
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: These must be set in production!
SECRET_KEY=
EXCHANGE_ENCRYPTION_KEY=

# ===========================================
# Exchange Mail Service Configuration
# ===========================================
# IMPORTANT: These must be configured for your environment!
EXCHANGE_SERVER=
EXCHANGE_DOMAIN=
EXCHANGE_EMAIL_SUFFIX=

# ===========================================
# Application Settings
# ===========================================
# WORKERS=2
