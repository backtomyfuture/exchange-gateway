# =============================================================================
# 环境变量配置（可选）
# 
# 使用方法：复制此文件为 .env，按需修改
#   cp .env.example .env
#
# 注意：大部分配置都有默认值，如果使用默认配置，不需要创建 .env 文件
# =============================================================================

# 数据库配置（默认值已满足大部分场景）
MYSQL_DATABASE=vue_fastapi_admin
MYSQL_USER=admin
DB_USER=admin
DB_NAME=vue_fastapi_admin

# Nginx 端口
NGINX_PORT=9999

# 应用 Worker 数量（生产环境建议 CPU 核数 * 2）
WORKERS=2

# =============================================================================
# Exchange 邮件服务配置
# =============================================================================
# Exchange 服务器地址
EXCHANGE_SERVER=10.72.8.110
# 域名
EXCHANGE_DOMAIN=hnanet
# 邮箱后缀
EXCHANGE_EMAIL_SUFFIX=@tianjin-air.com
# 凭据加密密钥（必须设置！）
# 生成方式: python -c "from app.utils.crypto import generate_encryption_key; print(generate_encryption_key())"
EXCHANGE_ENCRYPTION_KEY=
# API 速率限制（每分钟请求数）
EXCHANGE_API_RATE_LIMIT=10
# API Key 默认过期天数
EXCHANGE_API_KEY_EXPIRE_DAYS=365
